# Copy to .env.local to change anything. With no .env.local at all, the defaults below are used.

# Any OpenAI-compatible chat endpoint. Default: Ollama on this machine.
LLM_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key; hosted endpoints need a real one.
LLM_API_KEY=ollama
# Model that designs haunts. haunt-gemma is created by `npm run setup:model`.
LLM_MODEL=haunt-gemma
# Optional: a smaller, faster model for dialogue and epitaphs (defaults to LLM_MODEL).
# LLM_DIALOGUE_MODEL=gemma3:4b
# Gemma 4 "thinks" before answering unless this is "none". Leave it empty for endpoints
# that don't understand reasoning_effort.
LLM_REASONING_EFFORT=none
